diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0aaed20..8475823 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -73,17 +73,28 @@ set_target_properties(
   SOVERSION "${PROJECT_VERSION_MAJOR}"
   Fortran_MODULE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/include"
 )
+# Shared libraries carry their own runtime dependencies, only static ones
+# must propagate LAPACK/BLAS and OpenMP to consumers
+if(BUILD_SHARED_LIBS)
+  set(link-scope PRIVATE)
+else()
+  set(link-scope PUBLIC)
+endif()
 target_link_libraries(
   "${PROJECT_NAME}-lib"
   PUBLIC
   "${lib-deps}"
+)
+target_link_libraries(
+  "${PROJECT_NAME}-lib"
+  ${link-scope}
   "LAPACK::LAPACK"
   "$<$<VERSION_LESS:${CMAKE_VERSION},3.20>:BLAS::BLAS>"
 )
 if(WITH_OpenMP)
   target_link_libraries(
     "${PROJECT_NAME}-lib"
-    PUBLIC
+    ${link-scope}
     "OpenMP::OpenMP_Fortran"
   )
 endif()
